[
 {
  "id": 1,
  "duration": 11.507,
  "sentences": [
   {
    "start": 0.4,
    "end": 5.884,
    "text": "x = (−b ± √(b²−4ac)) / 2a"
   },
   {
    "start": 6.234,
    "end": 10.707,
    "text": "중학교 3학년이라면 누구나 한 번쯤, 주문처럼 외웠던 문장입니다."
   }
  ]
 },
 {
  "id": 2,
  "duration": 6.529,
  "sentences": [
   {
    "start": 0.4,
    "end": 3.386,
    "text": "그런데 이 공식, 처음부터 이렇게 생겼을까요?"
   },
   {
    "start": 3.736,
    "end": 5.729,
    "text": "도대체 누가, 왜 만들었을까요?"
   }
  ]
 },
 {
  "id": 3,
  "duration": 5.895,
  "sentences": [
   {
    "start": 0.4,
    "end": 3.036,
    "text": "시간을 1200년 전으로 돌려보겠습니다."
   },
   {
    "start": 3.386,
    "end": 5.095,
    "text": "장소는 바그다드입니다."
   }
  ]
 },
 {
  "id": 4,
  "duration": 12.262,
  "sentences": [
   {
    "start": 0.4,
    "end": 4.891,
    "text": "당시 바그다드는 세계에서 가장 큰 도시 가운데 하나였습니다."
   },
   {
    "start": 5.241,
    "end": 11.462,
    "text": "칼리프는 '지혜의 집'이라는 연구 기관을 세우고, 그리스와 인도의 책을 모아 아랍어로 옮기게 했습니다."
   }
  ]
 },
 {
  "id": 5,
  "duration": 12.15,
  "sentences": [
   {
    "start": 0.4,
    "end": 3.399,
    "text": "이곳에 알 콰리즈미라는 학자가 있었습니다."
   },
   {
    "start": 3.749,
    "end": 6.47,
    "text": "그가 다룬 문제는 아주 현실적이었습니다."
   },
   {
    "start": 6.82,
    "end": 11.35,
    "text": "유산을 어떻게 나눌지, 땅의 넓이를 어떻게 잴지 같은 문제들이었죠."
   }
  ]
 },
 {
  "id": 6,
  "duration": 10.321,
  "sentences": [
   {
    "start": 0.4,
    "end": 5.405,
    "text": "그런데 이런 문제를 식으로 세우면, 어떤 수를 제곱한 값이 자꾸 끼어들었습니다."
   },
   {
    "start": 5.755,
    "end": 9.521,
    "text": "오늘날 우리가 이차방정식이라고 부르는 문제입니다."
   }
  ]
 },
 {
  "id": 7,
  "duration": 18.333,
  "sentences": [
   {
    "start": 0.4,
    "end": 6.502,
    "text": "사실 이런 문제는 훨씬 오래전, 기원전 1800년 무렵 바빌로니아의 점토판에도 나옵니다."
   },
   {
    "start": 6.852,
    "end": 11.55,
    "text": "다만 그들이 남긴 것은, '이 문제는 이 순서로 계산하라'는 풀이 순서였습니다."
   },
   {
    "start": 11.9,
    "end": 17.534,
    "text": "서기 628년에는 인도의 브라마굽타가, 이 풀이를 말로 된 규칙으로 정리했습니다."
   }
  ]
 },
 {
  "id": 8,
  "duration": 8.877,
  "sentences": [
   {
    "start": 0.4,
    "end": 3.237,
    "text": "알 콰리즈미는 한 걸음 더 나아갔습니다."
   },
   {
    "start": 3.587,
    "end": 8.077,
    "text": "문제 하나하나가 아니라, 왜 그렇게 풀리는지를 그림으로 보여주려 한 겁니다."
   }
  ]
 },
 {
  "id": 9,
  "duration": 10.086,
  "sentences": [
   {
    "start": 0.4,
    "end": 3.324,
    "text": "그의 책에 나오는 대표 문제는 이것입니다."
   },
   {
    "start": 3.674,
    "end": 7.593,
    "text": "어떤 수의 제곱에, 그 수의 10배를 더했더니 39가 되었다."
   },
   {
    "start": 7.943,
    "end": 9.286,
    "text": "그 수는 무엇인가."
   }
  ]
 },
 {
  "id": 10,
  "duration": 14.496,
  "sentences": [
   {
    "start": 0.4,
    "end": 3.091,
    "text": "그 시절에는 x 같은 기호가 없었습니다."
   },
   {
    "start": 3.441,
    "end": 5.977,
    "text": "문제도 풀이도 전부 문장으로 썼죠."
   },
   {
    "start": 6.327,
    "end": 8.68,
    "text": "그래서 그는 그림을 그렸습니다."
   },
   {
    "start": 9.03,
    "end": 13.697,
    "text": "먼저 한 변이 x인 정사각형을 그립니다. 넓이는 x²입니다."
   }
  ]
 },
 {
  "id": 11,
  "duration": 13.352,
  "sentences": [
   {
    "start": 0.4,
    "end": 4.291,
    "text": "10x는 가로가 x, 세로가 10인 직사각형입니다."
   },
   {
    "start": 4.641,
    "end": 10.007,
    "text": "이것을 똑같이 네 조각으로 잘라서, 정사각형의 네 변에 하나씩 붙입니다."
   },
   {
    "start": 10.357,
    "end": 12.552,
    "text": "조각 하나의 폭은 2.5입니다."
   }
  ]
 },
 {
  "id": 12,
  "duration": 10.647,
  "sentences": [
   {
    "start": 0.4,
    "end": 4.187,
    "text": "그러면 십자 모양이 생기는데, 네 귀퉁이가 비어 있습니다."
   },
   {
    "start": 4.537,
    "end": 9.848,
    "text": "한 변이 2.5인 작은 정사각형 네 개. 넓이를 모두 더하면 25입니다."
   }
  ]
 },
 {
  "id": 13,
  "duration": 17.799,
  "sentences": [
   {
    "start": 0.4,
    "end": 3.921,
    "text": "귀퉁이를 채우면 커다란 정사각형이 완성됩니다."
   },
   {
    "start": 4.271,
    "end": 7.598,
    "text": "넓이는 원래의 39에, 25를 더한 64."
   },
   {
    "start": 7.948,
    "end": 11.128,
    "text": "넓이가 64인 정사각형의 한 변은 8입니다."
   },
   {
    "start": 11.478,
    "end": 16.999,
    "text": "그 한 변은 x에 2.5를 양쪽으로 더한 길이니까, x = 8 − 5 = 3입니다."
   }
  ]
 },
 {
  "id": 14,
  "duration": 15.243,
  "sentences": [
   {
    "start": 0.4,
    "end": 3.939,
    "text": "모자란 귀퉁이를 채워서, 완전한 정사각형을 만든다."
   },
   {
    "start": 4.289,
    "end": 8.15,
    "text": "이것이 바로 우리가 배우는 '완전제곱식'의 정체입니다."
   },
   {
    "start": 8.5,
    "end": 14.443,
    "text": "그리고 근의 공식은, 이 과정을 모든 이차방정식에 한꺼번에 적용해서 얻은 결과입니다."
   }
  ]
 },
 {
  "id": 15,
  "duration": 17.485,
  "sentences": [
   {
    "start": 0.4,
    "end": 1.773,
    "text": "정리하면 이렇습니다."
   },
   {
    "start": 2.123,
    "end": 6.974,
    "text": "이차방정식이 까다로운 건, x²과 x가 뒤섞여 있기 때문입니다."
   },
   {
    "start": 7.324,
    "end": 12.989,
    "text": "정사각형을 완성하면 둘이, (x + 5)²이라는 한 덩어리로 합쳐집니다."
   },
   {
    "start": 13.339,
    "end": 16.685,
    "text": "덩어리가 하나가 되면, 제곱근만 구하면 끝입니다."
   }
  ]
 },
 {
  "id": 16,
  "duration": 16.299,
  "sentences": [
   {
    "start": 0.4,
    "end": 1.824,
    "text": "여기서 흔한 오해 하나."
   },
   {
    "start": 2.174,
    "end": 7.064,
    "text": "근의 공식은 인수분해가 안 될 때만 쓰는 특별한 공식이라는 생각이죠."
   },
   {
    "start": 7.414,
    "end": 15.499,
    "text": "사실은 반대입니다. 근의 공식은 모든 이차방정식을 여는 만능 열쇠이고, 인수분해는 운이 좋을 때 쓰는 지름길입니다."
   }
  ]
 },
 {
  "id": 17,
  "duration": 20.222,
  "sentences": [
   {
    "start": 0.4,
    "end": 2.247,
    "text": "이제 공식을 다시 보겠습니다."
   },
   {
    "start": 2.597,
    "end": 10.588,
    "text": "앞부분의 b/2a는, 아까 정사각형 한 변에 양쪽으로 덧붙인 길이, 2.5 + 2.5 = 5에 해당합니다."
   },
   {
    "start": 10.938,
    "end": 19.422,
    "text": "알 콰리즈미가 '10의 절반'이라고 부른 바로 그 수죠. 마이너스가 붙은 건, 큰 변에서 이만큼을 빼야 x가 남기 때문입니다."
   }
  ]
 },
 {
  "id": 18,
  "duration": 14.031,
  "sentences": [
   {
    "start": 0.4,
    "end": 5.969,
    "text": "루트 안의 b² − 4ac는, 완성한 정사각형의 넓이를 결정합니다."
   },
   {
    "start": 6.319,
    "end": 9.871,
    "text": "그래서 이 값이 음수면, 중학교 범위에서는 해가 없습니다."
   },
   {
    "start": 10.221,
    "end": 13.231,
    "text": "넓이가 음수인 정사각형은 그릴 수 없으니까요."
   }
  ]
 },
 {
  "id": 19,
  "duration": 17.45,
  "sentences": [
   {
    "start": 0.4,
    "end": 2.678,
    "text": "알 콰리즈미의 문제로 확인해 볼까요."
   },
   {
    "start": 3.028,
    "end": 9.277,
    "text": "x² + 10x − 39 = 0. a = 1, b = 10, c = −39입니다."
   },
   {
    "start": 9.627,
    "end": 13.961,
    "text": "b² − 4ac = 100 + 156 = 256"
   },
   {
    "start": 14.311,
    "end": 16.65,
    "text": "√256 = 16"
   }
  ]
 },
 {
  "id": 20,
  "duration": 18.17,
  "sentences": [
   {
    "start": 0.4,
    "end": 3.996,
    "text": "x = (−10 + 16) ÷ 2 = 3"
   },
   {
    "start": 4.346,
    "end": 8.439,
    "text": "또는 x = (−10 − 16) ÷ 2 = −13"
   },
   {
    "start": 8.789,
    "end": 11.332,
    "text": "그림으로 찾은 3이 그대로 나왔습니다."
   },
   {
    "start": 11.682,
    "end": 17.37,
    "text": "−13은 알 콰리즈미가 버린 답입니다. 그에게 길이는 음수일 수 없었으니까요."
   }
  ]
 },
 {
  "id": 21,
  "duration": 8.761,
  "sentences": [
   {
    "start": 0.4,
    "end": 1.347,
    "text": "오늘의 한 줄."
   },
   {
    "start": 1.697,
    "end": 7.961,
    "text": "근의 공식은 외우는 주문이 아니라, 모자란 귀퉁이를 채워 정사각형을 완성하는 이야기입니다."
   }
  ]
 },
 {
  "id": 22,
  "duration": 18.157,
  "sentences": [
   {
    "start": 0.4,
    "end": 8.805,
    "text": "덧붙이면, 책 제목의 '알 자브르'에서 대수학(algebra)이, 그의 이름에서 '알고리즘(algorithm)'이 나왔습니다."
   },
   {
    "start": 9.155,
    "end": 15.525,
    "text": "다음 시간에는 이 정사각형이 그래프 위에서 어떻게 보이는지, 이차함수 이야기를 해보겠습니다."
   },
   {
    "start": 15.875,
    "end": 17.357,
    "text": "최고의 공부였습니다."
   }
  ]
 }
]