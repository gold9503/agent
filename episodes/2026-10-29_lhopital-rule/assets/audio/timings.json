[
 {
  "id": 1,
  "duration": 17.485,
  "sentences": [
   {
    "start": 0.4,
    "end": 3.824,
    "text": "분자도 0으로, 분모도 0으로 가는 분수가 있습니다."
   },
   {
    "start": 4.395,
    "end": 6.435,
    "text": "이 분수는 결국 어디로 갈까요?"
   },
   {
    "start": 7.001,
    "end": 10.89,
    "text": "많은 학생이 주문처럼 외웁니다. \"위아래를 따로 미분하라.\""
   },
   {
    "start": 11.339,
    "end": 12.586,
    "text": "로피탈의 정리입니다."
   },
   {
    "start": 13.102,
    "end": 16.685,
    "text": "그런데 이 정리의 주인은, 정말 로피탈일까요?"
   }
  ]
 },
 {
  "id": 2,
  "duration": 12.223,
  "sentences": [
   {
    "start": 0.4,
    "end": 2.372,
    "text": "1696년, 파리."
   },
   {
    "start": 3.019,
    "end": 7.761,
    "text": "로피탈 후작이 미분을 다룬 최초의 교과서, 『무한소 해석』을 펴냅니다."
   },
   {
    "start": 8.435,
    "end": 11.423,
    "text": "그런데 이 책엔 숨은 스승이 있었습니다."
   }
  ]
 },
 {
  "id": 3,
  "duration": 13.892,
  "sentences": [
   {
    "start": 0.4,
    "end": 3.204,
    "text": "스위스의 젊은 수학자, 요한 베르누이."
   },
   {
    "start": 3.909,
    "end": 7.835,
    "text": "1694년 3월, 로피탈은 그에게 편지를 씁니다."
   },
   {
    "start": 8.576,
    "end": 13.092,
    "text": "해마다 300리브르를 줄 테니, 새 발견을 자신에게만 알려 달라고요."
   }
  ]
 },
 {
  "id": 4,
  "duration": 16.841,
  "sentences": [
   {
    "start": 0.4,
    "end": 6.04,
    "text": "그해 7월, 베르누이가 보낸 편지에 0/0 꼴을 푸는 방법이 담겨 있었습니다."
   },
   {
    "start": 6.736,
    "end": 12.117,
    "text": "이 방법은 두 해 뒤 로피탈의 책에 실렸고, 그래서 지금은 그의 이름으로 불립니다."
   },
   {
    "start": 12.791,
    "end": 16.041,
    "text": "로피탈도 머리말에서 베르누이의 도움을 밝혔죠."
   }
  ]
 },
 {
  "id": 5,
  "duration": 13.877,
  "sentences": [
   {
    "start": 0.4,
    "end": 4.111,
    "text": "0/0 꼴은 왜 위아래를 미분하면 풀릴까요?"
   },
   {
    "start": 4.718,
    "end": 8.878,
    "text": "그래프로 보면, 분자와 분모가 같은 점에서 x축을 지납니다."
   },
   {
    "start": 9.601,
    "end": 13.078,
    "text": "그 점 근처를 확대하면, 곡선은 거의 직선입니다."
   }
  ]
 },
 {
  "id": 6,
  "duration": 17.204,
  "sentences": [
   {
    "start": 0.4,
    "end": 3.251,
    "text": "직선의 높이는 기울기 곱하기 떨어진 거리."
   },
   {
    "start": 3.827,
    "end": 7.888,
    "text": "두 높이를 나누면 거리는 약분되고, 기울기의 비만 남습니다."
   },
   {
    "start": 8.503,
    "end": 13.749,
    "text": "0/0의 정체는, 두 함수가 0으로 다가가는 빠르기의 비였던 겁니다."
   },
   {
    "start": 14.294,
    "end": 16.404,
    "text": "그 빠르기가 바로 도함수죠."
   }
  ]
 },
 {
  "id": 7,
  "duration": 13.488,
  "sentences": [
   {
    "start": 0.4,
    "end": 3.266,
    "text": "두 선수가 결승선에 동시에 들어온다고 해 봅시다."
   },
   {
    "start": 3.908,
    "end": 6.956,
    "text": "남은 거리로는 비교가 안 되죠. 둘 다 0이니까요."
   },
   {
    "start": 7.516,
    "end": 12.688,
    "text": "속도를 보면 됩니다. 세 배 빠른 선수는 직전까지 남은 거리도 세 배니까요."
   }
  ]
 },
 {
  "id": 8,
  "duration": 16.767,
  "sentences": [
   {
    "start": 0.4,
    "end": 1.438,
    "text": "흔한 실수 하나."
   },
   {
    "start": 2.033,
    "end": 5.791,
    "text": "0/0 꼴이 아닌데도 위아래를 미분하는 겁니다."
   },
   {
    "start": 6.421,
    "end": 12.767,
    "text": "x → 0일 때, (x + 1)/(x + 2)의 극한은 1/2인데,"
   },
   {
    "start": 13.203,
    "end": 15.967,
    "text": "위아래를 미분하면 엉뚱하게 1이 나옵니다."
   }
  ]
 },
 {
  "id": 9,
  "duration": 18.588,
  "sentences": [
   {
    "start": 0.4,
    "end": 1.635,
    "text": "정확히는 이렇습니다."
   },
   {
    "start": 2.197,
    "end": 7.884,
    "text": "x → a일 때 분자와 분모가 함께 0, 또는 함께 ∞로 가고,"
   },
   {
    "start": 8.424,
    "end": 12.999,
    "text": "a 근처에서 둘 다 미분 가능하고 g′(x) ≠ 0이며,"
   },
   {
    "start": 13.303,
    "end": 17.788,
    "text": "f′/g′의 극한이 존재하면, 원래 극한도 그 값과 같습니다."
   }
  ]
 },
 {
  "id": 10,
  "duration": 11.97,
  "sentences": [
   {
    "start": 0.4,
    "end": 6.841,
    "text": "예제 하나. x → 1일 때, (x³ − 1)/(x − 1)"
   },
   {
    "start": 7.47,
    "end": 11.17,
    "text": "1을 넣어 보면 0/0, 첫 번째 조건이 맞습니다."
   }
  ]
 },
 {
  "id": 11,
  "duration": 10.449,
  "sentences": [
   {
    "start": 0.4,
    "end": 5.42,
    "text": "위아래를 미분하면 3x²/1. 1을 넣으면 3입니다."
   },
   {
    "start": 5.979,
    "end": 9.649,
    "text": "분자가 분모보다 세 배 빠르게 0에 다가간다는 뜻입니다."
   }
  ]
 },
 {
  "id": 12,
  "duration": 16.791,
  "sentences": [
   {
    "start": 0.4,
    "end": 1.186,
    "text": "오늘의 한 줄."
   },
   {
    "start": 1.757,
    "end": 7.344,
    "text": "0/0은 빠르기 대결이고, 로피탈의 정리는 그 승부를 기울기로 가립니다."
   },
   {
    "start": 8.056,
    "end": 10.539,
    "text": "다만 쓰기 전에, 꼴부터 확인하세요."
   },
   {
    "start": 11.399,
    "end": 14.139,
    "text": "다음 시간에는 테일러 급수 이야기를 해 보겠습니다."
   },
   {
    "start": 14.669,
    "end": 15.991,
    "text": "최고의 공부였습니다."
   }
  ]
 }
]