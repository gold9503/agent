[
 {
  "id": 1,
  "duration": 11.508,
  "sentences": [
   {
    "start": 0.4,
    "end": 4.043,
    "text": "종이 두 장을 나란히 들고, 그 사이로 숨을 세게 불어 보세요."
   },
   {
    "start": 4.65,
    "end": 6.086,
    "text": "종이는 벌어지지 않습니다."
   },
   {
    "start": 6.525,
    "end": 7.847,
    "text": "오히려 서로 달라붙죠."
   },
   {
    "start": 8.526,
    "end": 10.708,
    "text": "바람이 밀었는데, 왜 다가올까요?"
   }
  ]
 },
 {
  "id": 2,
  "duration": 9.811,
  "sentences": [
   {
    "start": 0.4,
    "end": 3.74,
    "text": "이 수수께끼의 열쇠를 찾은 사람, 다니엘 베르누이입니다."
   },
   {
    "start": 4.387,
    "end": 9.011,
    "text": "미분을 처음 책으로 낸 로피탈의 숨은 스승, 요한 베르누이의 아들이죠."
   }
  ]
 },
 {
  "id": 3,
  "duration": 11.422,
  "sentences": [
   {
    "start": 0.4,
    "end": 5.412,
    "text": "1734년, 파리 아카데미가 상을 아버지와 아들에게 함께 줍니다."
   },
   {
    "start": 6.039,
    "end": 10.622,
    "text": "아들과 같은 급이 된 게 분했던 아버지는, 아들을 집에서 내쫓았다고 전해집니다."
   }
  ]
 },
 {
  "id": 4,
  "duration": 10.198,
  "sentences": [
   {
    "start": 0.4,
    "end": 4.473,
    "text": "1738년, 다니엘은 『유체역학』이라는 책을 펴냅니다."
   },
   {
    "start": 5.217,
    "end": 9.398,
    "text": "아버지는 나중에 낸 자기 책에 더 이른 연도를 적었다는 의심을 받죠."
   }
  ]
 },
 {
  "id": 5,
  "duration": 15.335,
  "sentences": [
   {
    "start": 0.4,
    "end": 3.157,
    "text": "다니엘은 흐르는 물의 압력을 재고 싶었습니다."
   },
   {
    "start": 3.796,
    "end": 6.538,
    "text": "관 벽에 구멍을 뚫고, 가는 유리관을 세웠죠."
   },
   {
    "start": 7.185,
    "end": 10.137,
    "text": "물이 세게 밀수록, 유리관 속 물기둥이 높아집니다."
   },
   {
    "start": 10.769,
    "end": 14.535,
    "text": "그런데 물이 흐르기 시작하자, 물기둥이 오히려 낮아졌습니다."
   }
  ]
 },
 {
  "id": 6,
  "duration": 14.542,
  "sentences": [
   {
    "start": 0.4,
    "end": 3.111,
    "text": "물 한 덩어리가 지갑을 들고 흐른다고 해 봅시다."
   },
   {
    "start": 3.802,
    "end": 5.046,
    "text": "총액은 정해져 있습니다."
   },
   {
    "start": 5.53,
    "end": 9.419,
    "text": "주머니는 셋. 미는 주머니, 달리는 주머니, 높이 주머니."
   },
   {
    "start": 10.215,
    "end": 13.742,
    "text": "좁은 길에서 빨리 달리려면, 미는 주머니에서 꺼내 써야 하죠."
   }
  ]
 },
 {
  "id": 7,
  "duration": 8.753,
  "sentences": [
   {
    "start": 0.4,
    "end": 4.456,
    "text": "물이 좁은 곳에서 빨라지면, 그 위 물기둥은 쑥 낮아집니다."
   },
   {
    "start": 5.053,
    "end": 7.953,
    "text": "빨라진 만큼, 미는 주머니에서 꺼내 쓴 겁니다."
   }
  ]
 },
 {
  "id": 8,
  "duration": 10.249,
  "sentences": [
   {
    "start": 0.4,
    "end": 1.927,
    "text": "종이 사이 공기도 같습니다."
   },
   {
    "start": 2.45,
    "end": 7.083,
    "text": "좁은 틈을 빨리 지나느라 덜 밀고, 바깥 공기가 종이를 안으로 밀어붙인 거죠."
   },
   {
    "start": 7.658,
    "end": 9.449,
    "text": "이것이 베르누이의 원리입니다."
   }
  ]
 },
 {
  "id": 9,
  "duration": 12.381,
  "sentences": [
   {
    "start": 0.4,
    "end": 2.696,
    "text": "이 원리는 비행기 설명에 꼭 나옵니다."
   },
   {
    "start": 3.308,
    "end": 8.716,
    "text": "날개 위쪽 길이 더 기니, 위아래 공기가 끝에서 동시에 만나려면 위쪽이 빨라야 한다."
   },
   {
    "start": 9.232,
    "end": 11.581,
    "text": "그럴듯하죠? 하지만 틀렸습니다."
   }
  ]
 },
 {
  "id": 10,
  "duration": 15.66,
  "sentences": [
   {
    "start": 0.4,
    "end": 4.569,
    "text": "연기로 흐름을 찍어 보면, 위쪽 공기가 훨씬 먼저 끝에 도착합니다."
   },
   {
    "start": 5.233,
    "end": 9.575,
    "text": "날개는 공기를 아래로 꺾어 내리고, 그 반작용으로 위로 힘을 받습니다."
   },
   {
    "start": 10.229,
    "end": 14.86,
    "text": "아래로 미는 힘과 날개 위의 낮은 압력, 같은 흐름의 두 얼굴입니다."
   }
  ]
 },
 {
  "id": 11,
  "duration": 12.309,
  "sentences": [
   {
    "start": 0.4,
    "end": 2.101,
    "text": "이제 지갑을 식으로 써 봅시다."
   },
   {
    "start": 2.746,
    "end": 7.061,
    "text": "압력 더하기 움직임의 에너지 더하기 높이의 에너지는, 늘 일정."
   },
   {
    "start": 7.666,
    "end": 11.509,
    "text": "정확히는, 마찰 없이 한 줄기로 고르게 흐를 때의 이야기입니다."
   }
  ]
 },
 {
  "id": 12,
  "duration": 19.834,
  "sentences": [
   {
    "start": 0.4,
    "end": 6.14,
    "text": "수평 관에서 초속 1m로 흐르던 물이, 단면 넓이가 절반인 곳에선 초속 2m가 됩니다."
   },
   {
    "start": 6.823,
    "end": 11.246,
    "text": "속력이 두 배니, 움직임의 에너지는 네 배. 500에서 2000이 됩니다."
   },
   {
    "start": 11.877,
    "end": 15.052,
    "text": "총액은 그대로니까 압력은 1500Pa 줄어들죠."
   },
   {
    "start": 15.697,
    "end": 19.034,
    "text": "유리관 물기둥이 약 15cm 내려가는 만큼입니다."
   }
  ]
 },
 {
  "id": 13,
  "duration": 16.147,
  "sentences": [
   {
    "start": 0.4,
    "end": 3.586,
    "text": "오늘의 한 줄. 빨라진 공기는, 덜 밉니다."
   },
   {
    "start": 4.355,
    "end": 9.266,
    "text": "여러분 입김이 종이를 붙인 그 원리가, 오늘도 하늘에서 여객기를 받칩니다."
   },
   {
    "start": 9.993,
    "end": 13.521,
    "text": "다음 시간엔, 물이 왜 좁은 곳에서 빨라지는지 알아봅니다."
   },
   {
    "start": 14.093,
    "end": 15.347,
    "text": "최고의 공부였습니다."
   }
  ]
 }
]