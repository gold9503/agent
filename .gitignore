# 비밀 정보 (API 키, OAuth 토큰)
.env
*.env
client_secret*.json
token*.json

# 대용량 산출물 (다시 만들 수 있음: scripts/make_episode.sh)
#  - 실사 소재는 assets/sources.json의 원본 URL(AI 소재는 생성 기록)로 다시 받을 수 있다
episodes/*/assets/render/
episodes/*/assets/build/
episodes/*/assets/media/
